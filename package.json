{
  "name": "isport-college",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @isport/portal test:e2e",
    "release": "pnpm build && node scripts/release.mjs",
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:css": "stylelint \"**/*.{css,scss,vue}\""
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "normalize.css": "^8.0.1",
    "prettier": "^3.9.8",
    "stylelint": "^17.15.0",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "turbo": "^2.5.8",
    "@isport/eslint-config": "workspace:*"
  }
}
