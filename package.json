{
  "name": "isport-college",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "^24.11.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:e2e": "pnpm --filter @isport/portal test:e2e",
    "test:e2e:built": "pnpm --filter @isport/portal test:e2e:built",
    "check": "pnpm lint && pnpm lint:css && pnpm format:check && pnpm typecheck && pnpm test && pnpm build && pnpm test:e2e:built",
    "check:ci": "CI=1 pnpm check",
    "bootstrap": "pnpm install",
    "clean:dependencies": "rimraf --glob \"pnpm-lock.yaml\" \"package-lock.json\" \"yarn.lock\" \"node_modules\" \"apps/*/node_modules\" \"packages/*/node_modules\"",
    "reinstall": "pnpm run clean:dependencies && pnpm run bootstrap",
    "release": "pnpm check && node scripts/release.mjs",
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:css": "stylelint \"**/*.{css,scss,vue}\"",
    "preinstall": "npx only-allow pnpm && git config core.ignorecase false"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@isport/eslint-config": "workspace:*",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "rimraf": "^6.1.3",
    "stylelint": "^17.15.0",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "turbo": "^2.5.8"
  }
}
