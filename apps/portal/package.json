{
  "name": "@isport/portal",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxi dev --dotenv .env.development",
    "build": "pnpm build:prod",
    "postinstall": "nuxi prepare",
    "lint": "eslint .",
    "typecheck": "nuxi typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:built": "E2E_USE_BUILT_OUTPUT=true playwright test",
    "test:e2e:roles:built": "E2E_USE_BUILT_OUTPUT=true playwright test e2e/role-navigation.spec.ts e2e/route-gate.spec.ts",
    "test:coverage": "vitest run --coverage",
    "build:prod": "nuxi build --dotenv .env.production && node ../../scripts/finalize-build.mjs production",
    "build:test": "nuxi build --dotenv .env.test && node ../../scripts/finalize-build.mjs test",
    "build:staging": "nuxi build --dotenv .env.staging && node ../../scripts/finalize-build.mjs staging"
  },
  "dependencies": {
    "@isport/design-tokens": "workspace:*",
    "@isport/i18n": "workspace:*",
    "@isport/rich-text": "workspace:*",
    "@isport/shared": "workspace:*",
    "@isport/ui-core": "workspace:*",
    "@isport/unocss-preset": "workspace:*",
    "@nuxtjs/i18n": "10.6.0",
    "@nuxtjs/sitemap": "8.6.2",
    "@pinia/nuxt": "0.11.3",
    "@unocss/nuxt": "66.10.5",
    "antdv-next": "1.7.0",
    "dayjs": "1.11.23",
    "normalize.css": "8.0.1",
    "nuxt": "4.5.2",
    "nuxt-swiper": "2.0.2",
    "pinia": "3.0.4",
    "pinia-plugin-persistedstate": "4.7.1",
    "swiper": "12.2.0",
    "vue": "3.5.43",
    "vue-router": "5.3.1",
    "xgplayer": "3.0.26"
  },
  "devDependencies": {
    "@antdv-next/nuxt": "1.1.0",
    "@isport/tsconfig": "workspace:*",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.2",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.5",
    "sass-embedded": "1.104.1",
    "typescript": "5.9.3",
    "unocss": "66.10.5",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.11"
  }
}
