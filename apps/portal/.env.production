# 生产部署：SSR 后端使用正式域名的 /academy 前缀。
# 构建命令加载本文件，配置写入部署产物，无需在服务器另行注入。
NUXT_API_BASE=https://academy.dream-sports.cn/academy
NUXT_PUBLIC_API_BASE=/
NUXT_PUBLIC_SITE_ENV=production
NUXT_PUBLIC_DOCUMENT_PREVIEW_BASE="https://academy.dream-sports.cn/viewer/?showHeader=0&showImport=0&showUrlImport=0&showToolbar=1&showErrors=0"
