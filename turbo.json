{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["NUXT_API_BASE", "NUXT_PUBLIC_API_BASE", "NUXT_PUBLIC_SITE_ENV"],
      "outputs": ["dist/**", ".output/**", "src/css-vars.css", "src/tokens.json"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "cache": false
    }
  },
  "globalDependencies": [
    "eslint.config.mjs",
    "packages/eslint-config/**",
    "stylelint.config.mjs",
    "prettier.config.mjs"
  ]
}
